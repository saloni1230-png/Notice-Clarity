NS_ENVIRONMENT=development
# Enable only when this API service owns all processing; leave false with Compose workers.
NS_EMBEDDED_WORKER=false
NS_DATABASE_URL=postgresql+psycopg://notice:notice@db:5432/notice
NS_PUBLIC_URL=http://localhost:65030
NS_SECRET=development-only-replace-with-64-random-characters-before-deployment
NS_STORAGE=local
NS_LOCAL_STORAGE=/data/objects
NS_REQUIRE_EMAIL_VERIFICATION=false
NS_SECURE_COOKIES=false
NS_SMTP_HOST=mailpit
NS_SMTP_PORT=1025
NS_SMTP_TLS=false
NS_MAIL_FROM=Notice Clarity <noreply@example.test>
NS_AI_API_KEY=
NS_AI_BASE_URL=https://api.openai.com/v1
NS_AI_MODEL=
NS_AI_STRONG_MODEL=
# Maximum prices across every configured model, including strong/embedding.
# Enter actual conservative provider prices; zero keeps AI disabled at startup.
NS_AI_PRICE_INPUT_PER_MILLION=0
NS_AI_PRICE_OUTPUT_PER_MILLION=0
NS_EMBEDDING_MODEL=
NS_RERANKER_MODEL=
NS_ORG_DAILY_TOKENS=80000
NS_ORG_DAILY_COST_USD=3
NS_ORG_AI_CONCURRENCY=2
NS_MAX_JOBS_PER_ORG=12
NS_DOCUMENT_DAYS=90
NS_SCANNER_HOST=clamav
NS_SCANNER_PORT=3310
NS_METRICS_TOKEN=development-metrics-token-replace-me
NS_S3_BUCKET=notice-private
NS_S3_REGION=ap-south-1
NS_S3_KMS_KEY=
# AWS credentials via workload identity/IAM role in production; never commit secrets.
